
URL_BASE = http://localhost:8000
APP_PATH = /braso
CONTEX_PATH = /armazem_paraiba

DB_HOST = 
DB_USER = 
DB_PASSWORD = 
DB_NAME = 
APP_KEY = 

; Módulo WhatsApp (0 = desligado, 1 = ligado no tenant)
WHATSAPP_ENABLED = 0
; Número usado no botão "Enviar mensagem de teste" (opcional)
WHATSAPP_TEST_NUMBER =

# URL usada nos QR Codes da Ficha Funcional (opcional).
# Informe apenas scheme + host, sem o caminho /braso, por exemplo:
# FICHA_PUBLICA_URL_BASE = https://app.suaempresa.com.br
FICHA_PUBLICA_URL_BASE =

# Chave de autenticação da API de Contabilidade
CONTABILIDADE_API_KEY = sua_chave_secreta_aqui

#CONEXAO COM BANCO DE DADOS DA TECHPS
DB2_HOST = 
DB2_USER = 
DB2_PASSWORD = 
DB2_NAME = 

; SUPORTE API - URL base da API de suporte (server.js) e chaves usadas pelas telas de chamados/gestão
; e pela sincronização de setores (cadastro_setor.php, apenas no domínio /demo)
SUPORTE_API_URL =
SUPORTE_API_KEY =
SUPORTE_ADMIN_KEY =

; Assistente Virtual (100% local, via Ollama)
; 0 = desligado. Para ligar, defina 1 no ambiente do tenant.
ASSISTENTE_ENABLED = 0
; ollama = respostas naturais via LLM local
; extrativo = sem LLM; responde com FAQ + trechos da base
ASSISTENTE_PROVIDER = ollama
; 1.5b = mais rápido em CPU; 3b/7b = mais qualidade (GPU recomendada)
ASSISTENTE_MODEL = qwen2.5:1.5b
; Modelo usado para perguntas complexas quando ASSISTENTE_ROUTER=1
ASSISTENTE_MODEL_COMPLEX = qwen2.5:3b
ASSISTENTE_ROUTER = 1
ASSISTENTE_EMBED_MODEL = nomic-embed-text
ASSISTENTE_OLLAMA_URL = http://127.0.0.1:11434
ASSISTENTE_MAX_TOKENS = 350
ASSISTENTE_TEMPERATURE = 0.1
ASSISTENTE_DAILY_QUOTA = 300
ASSISTENTE_RATE_LIMIT = 20
ASSISTENTE_TIMEOUT = 180
ASSISTENTE_RETENTION_DAYS = 90
ASSISTENTE_TOP_CHUNKS = 5
ASSISTENTE_MIN_SCORE = 0.9
; Contexto e threads do Ollama. 0 em NUM_THREAD = automático.
ASSISTENTE_NUM_CTX = 6144
ASSISTENTE_NUM_THREAD = 0
; Mantém o modelo carregado para evitar cold start (30m, 1h, -1 etc.)
ASSISTENTE_KEEP_ALIVE = 1h
ASSISTENTE_EMBEDDINGS = 0

; Pasta persistente de anexos do CRM - TECHPS, fora do document root.
; Ex.: /var/lib/techps/whatsapp-media (permissão de escrita para o PHP)
WHATSAPP_MEDIA_PATH =

; Este arquivo NÃO deve ser copiado para dentro do document root.
; Em produção, defina TECHPS_ENV_FILE=/caminho/fora/public_html/techps.env
; ou coloque o arquivo como techps.env no diretório pai do projeto.
TECHPS_ENV_FILE =
